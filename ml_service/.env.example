# ══════════════════════════════════════════════════════════════════════════════
#  NeuroAI — ML Service Environment Variables
#  Copy this file to .env and fill in your values.
#  Restart uvicorn after any change.
# ══════════════════════════════════════════════════════════════════════════════

# ── Dev mode ──────────────────────────────────────────────────────────────────
# Set to true to enable local/dev shortcuts
LOCAL_DEV=true

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Set OLLAMA_ENABLED=true to use a local Ollama instance instead of a cloud API
OLLAMA_ENABLED=true
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin of the frontend (must match Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# ── RapidAPI ──────────────────────────────────────────────────────────────────
# Get a key at https://rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here

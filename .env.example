# ══════════════════════════════════════════════════════════════════════════════
#  NeuroAI — Frontend Environment Variables
#  Copy this file to .env and fill in your values.
#  Restart the Vite dev server after any change.
# ══════════════════════════════════════════════════════════════════════════════

# ── Backend connection ────────────────────────────────────────────────────────
# Must match the PORT set in backend/.env (default 5000)
VITE_API_URL=http://localhost:5000

# ML service URL (used by ML integrations)
VITE_ML_URL=http://localhost:8000

# ── Groq (AI Study Plan page) ─────────────────────────────────────────────────
# Get a free key at https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# ── Vapi (AI Interview — voice SDK) ──────────────────────────────────────────
# Use your PUBLIC key from https://dashboard.vapi.ai → API Keys → Public Key
# This is safe to use on the frontend (it is scoped to call initiation only).
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# ══════════════════════════════════════════════════════════════════════════════
#  NeuroAI — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  Restart the server after any change.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/neurolearn
# Atlas (replace USER, PASS, cluster and DB name):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/neurolearn?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long, random string — e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Groq ──────────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── AI Interview System (Vapi) ────────────────────────────────────────────────
# VAPI_PRIVATE_KEY: your PRIVATE key from https://dashboard.vapi.ai → API Keys → Private Key
# Used by the backend to create/manage assistants via the Vapi REST API.
# Optional — if not set, assistant config is sent inline to the frontend.
VAPI_PRIVATE_KEY=your_vapi_private_key_here

# Groq model used for interview question generation and post-interview analysis
INTERVIEW_GROQ_MODEL=llama-3.3-70b-versatile

# ML service URL used by backend integrations
ML_SERVICE_URL=http://localhost:8000
